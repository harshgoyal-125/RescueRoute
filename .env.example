# ==========================================
# RescueRoute - Production Environment Configuration
# ==========================================

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000/api

# Backend Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB URI or Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/rescueroute

# Authentication & Session Security
JWT_SECRET=production_jwt_super_secret_key_change_me
JWT_EXPIRES_IN=7d

# CORS - Allowed Frontend Origin
CLIENT_URL=http://localhost:5173

# Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=20

# AI Configuration (Gemini API - Server-side only, optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Matching & Dispatch Limits
MATCH_MAX_DISTANCE_KM=50
MATCH_RESULT_LIMIT=10
